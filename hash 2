import java.util.HashMap;

public class RomanToInteger {
    public static int romanToInt(String s) {
        HashMap<Character, Integer> values = new HashMap<>();
        values.put('I', 1);
        values.put('V', 5);
        values.put('X', 10);
        values.put('L', 50);
        values.put('C', 100);
        values.put('D', 500);
        values.put('M', 1000);
        
        int total = 0;
        
        for (int i = 0; i < s.length(); i++) {
            int currentVal = values.get(s.charAt(i));
            
            // Check if there is a next character and if the current value is less than the next one
            if (i < s.length() - 1 && currentVal < values.get(s.charAt(i + 1))) {
                total -= currentVal; // Subtract for cases like IV (4) or IX (9)
            } else {
                total += currentVal; // Otherwise, just add the value
            }
        }
        
        return total;
    }
}
